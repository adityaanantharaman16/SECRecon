# Run python scripts/bootstrap.py to create random local credentials.
POSTGRES_USER=secrecon
POSTGRES_DB=secrecon
POSTGRES_PASSWORD=replace-with-local-random-password
S3_ACCESS_KEY=secrecon
S3_SECRET_KEY=replace-with-local-random-password
SECRECON_DATABASE_URL=postgresql+psycopg://secrecon:replace-with-local-random-password@localhost:55432/secrecon
SECRECON_REDIS_URL=redis://localhost:56379/0
SECRECON_S3_ENDPOINT=http://localhost:58333
SECRECON_S3_ACCESS_KEY=secrecon
SECRECON_S3_SECRET_KEY=replace-with-local-random-password
SECRECON_S3_BUCKET=secrecon-raw
SECRECON_SEC_MODE=offline
# Required for live SEC requests: SECRecon your-real-contact-address
SECRECON_SEC_USER_AGENT=

